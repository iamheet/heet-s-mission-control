# ── jarvis-core-api ─────────────────────────────────────────────────────────
# Copy to `.env` and fill in real values. NEVER commit the real .env.

# ── Auth ──
# Single admin user (you). Password is bcrypt-verified; generate a hash with:
#   python -c "from auth import hash_password; print(hash_password('yourpass'))"
JARVIS_ADMIN_USER=heet
JARVIS_ADMIN_PASSWORD_HASH=
# Fallback plaintext password — used ONLY if no hash is set (dev convenience).
JARVIS_ADMIN_PASSWORD=changeme
# Secret used to sign JWTs. Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=please-change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# ── CORS ── comma-separated list; restrict to your dashboard origin(s)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://iamheet.in

# ── Prometheus ──
PROMETHEUS_URL=http://localhost:9090
PROMETHEUS_TIMEOUT=8

# ── Kubernetes (K3s) ──
# Path to kubeconfig. K3s default: /etc/rancher/k3s/k3s.yaml
# Leave blank to use in-cluster service account (if running as a pod).
KUBECONFIG_PATH=/etc/rancher/k3s/k3s.yaml

# ── Logs ──
# "kubectl" tails all pod containers; "journalctl" tails systemd. "mock" for local dev.
LOG_SOURCE=mock
LOG_BUFFER_SIZE=500
AUTH_LOG_PATH=/var/log/auth.log

# ── Watchdog ──
WATCHDOG_ENABLED=true
WATCHDOG_INTERVAL_SECONDS=12
ALERT_COOLDOWN_MINUTES=30
ALERT_DB_PATH=./jarvis_alerts.db
OWNER_NAME=Heet

# ── Detection thresholds (tune without touching code) ──
CPU_WARN_PCT=90
CPU_SUSTAINED_MINUTES=2
MEM_WARN_PCT=90
MEM_CRIT_PCT=97
DISK_WARN_PCT=85
DISK_CRIT_PCT=95
POD_RESTART_THRESHOLD=3
POD_RESTART_WINDOW_MINUTES=10
POD_NOT_READY_MINUTES=2
AUTH_FAIL_THRESHOLD=5
AUTH_FAIL_WINDOW_MINUTES=5
NET_EGRESS_MULTIPLIER=3
SERVICE_DOWN_MINUTES=1
TLS_EXPIRY_WARN_DAYS=14

# Comma-separated health-check URLs the watchdog probes for the service-down rule
HEALTHCHECK_URLS=
# Comma-separated host:port pairs to check TLS expiry, e.g. iamheet.in:443
TLS_HOSTS=

# ── Email (Gmail SMTP) ──
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraddress@gmail.com
# Gmail App Password (16 chars, not your account password)
SMTP_PASSWORD=
SMTP_FROM=youraddress@gmail.com
SMTP_TO=youraddress@gmail.com
