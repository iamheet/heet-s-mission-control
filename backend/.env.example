# Ollama (fallback — used when Gemini fails/quota exhausted)
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL_FAST=llama3.2:3b
OLLAMA_MODEL_SMART=llama3.2:3b
OLLAMA_MODEL_TECH=llama3.2:3b

# Gemini (primary — handles all query routing)
GEMINI_API_KEY_1=your_gemini_key_1_here
GEMINI_API_KEY_2=your_gemini_key_2_here
GEMINI_MODEL=gemini-2.5-flash

# Server
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,https://iamheet.in
RATE_LIMIT_RPM=30
